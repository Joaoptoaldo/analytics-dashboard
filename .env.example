# Variáveis de ambiente para dashboard-de-analise

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_USE_EXTERNAL=true

# Backend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (local development: SQLite)
# Para produção: use PostgreSQL com DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./backend.db

# Development environment
ENV=development
ALLOW_SEED=false

# Segurança do sync externo
# Configure em produção para proteger o endpoint de sincronização.
EXTERNAL_SYNC_TOKEN=
EXTERNAL_SYNC_MIN_INTERVAL_SECONDS=60
