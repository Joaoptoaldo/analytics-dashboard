FROM node:20-slim

WORKDIR /app

ENV CI=1

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_USE_EXTERNAL=true
ARG VITE_EXTERNAL_SYNC_TOKEN=
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_TRACES_SAMPLE_RATE=0
ARG VITE_SENTRY_PROFILES_SAMPLE_RATE=0
ARG VITE_RELEASE=
ARG VITE_ENV=production

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_USE_EXTERNAL=${VITE_USE_EXTERNAL}
ENV VITE_EXTERNAL_SYNC_TOKEN=${VITE_EXTERNAL_SYNC_TOKEN}
ENV VITE_SENTRY_DSN=${VITE_SENTRY_DSN}
ENV VITE_SENTRY_TRACES_SAMPLE_RATE=${VITE_SENTRY_TRACES_SAMPLE_RATE}
ENV VITE_SENTRY_PROFILES_SAMPLE_RATE=${VITE_SENTRY_PROFILES_SAMPLE_RATE}
ENV VITE_RELEASE=${VITE_RELEASE}
ENV VITE_ENV=${VITE_ENV}

RUN npm run build

EXPOSE 4173

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4173"]