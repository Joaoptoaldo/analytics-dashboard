# .env.production — Configuração de Produção (Frontend + Backend)
#
# IMPORTANTE:
# - Este é um template. Substitua valores placeholder pelos REAIS.
# - NUNCA comite secrets reais neste arquivo (use Fly.io secrets ou CI/CD).
# - Siga as regras de validação em backend/config.py.

# ============================================================================
# FRONTEND (Vite Build)
# ============================================================================
#
# VITE_API_BASE_URL: URL da API em produção
# Deve estar DEFINIDO no momento do build (não runtime)
# Exemplo: https://dashboard.example.com/api
# CRÍTICO: Se não definido em build, frontend terá erro ou apontará para localhost
#

VITE_API_BASE_URL=https://dashboard.example.com/api

# VITE_EXTERNAL_SYNC_TOKEN: Token para sync (deve ser igual ao backend)
# Deixe em branco se não usar sync externo
# DEVE ser sincronizado com EXTERNAL_SYNC_TOKEN do backend

VITE_EXTERNAL_SYNC_TOKEN=gerar-token-aleatorio-seguro-32-chars-aqui

# VITE_USE_EXTERNAL: Usar dados externos (DummyJSON)?
VITE_USE_EXTERNAL=true

# ============================================================================
# BACKEND (FastAPI)
# ============================================================================
#
# DATABASE_URL: Conexão com banco de dados
# PROD: PostgreSQL (postgresql://...)
# DEV: SQLite (sqlite:///./backend.db)
#  NÃO use fallback silencioso em produção
#

DATABASE_URL=postgresql://neon_user:neon_password@db-endpoint.neon.tech/dashboard?sslmode=require

# CORS_ORIGINS: Domínios permitidos para CORS
# Formato: comma-separated list
# PROD: Whitelist explícita (https://seu-dominio.com)
# DEV: pode usar localhost
#  NÃO use "*" em produção
#

CORS_ORIGINS=https://dashboard.example.com,https://www.dashboard.example.com

# EXTERNAL_SYNC_TOKEN: Token para /internal/external-products/sync
# Gere valor aleatório seguro (32+ chars)
# Sincronize com VITE_EXTERNAL_SYNC_TOKEN do frontend
# Deixe vazio se não usar sincronização
#

EXTERNAL_SYNC_TOKEN=gerar-token-aleatorio-seguro-32-chars-aqui

# EXTERNAL_SYNC_MIN_INTERVAL_SECONDS: Intervalo mínimo entre sincronizações
EXTERNAL_SYNC_MIN_INTERVAL_SECONDS=60

# ENV: Modo de operação
# "production": validação estrita (recomendado para Fly.io)
# "development": validação flexível (recomendado para local)
#

ENV=production

# ALLOW_SEED: Permitir dados de seed ao iniciar?
# false: CRÍTICO em produção (impede sobrescrita de dados)
# true: aceito em dev (para testes)
#

ALLOW_SEED=false

# ============================================================================
# CHECKLIST ANTES DE USAR ESTE ARQUIVO
# ============================================================================
#
# ☐ Substituir VITE_API_BASE_URL pela URL REAL
# ☐ Substituir DATABASE_URL pela URL REAL do PostgreSQL (Neon, AWS RDS, etc)
# ☐ Substituir CORS_ORIGINS pelos domínios finais
# ☐ Gerar token seguro para EXTERNAL_SYNC_TOKEN (32+ chars)
# ☐ Sincronizar VITE_EXTERNAL_SYNC_TOKEN == EXTERNAL_SYNC_TOKEN
# ☐ Validar ENV=production
# ☐ Validar ALLOW_SEED=false
# ☐ Validar DATABASE_URL começa com "postgresql://"
# ☐ Validar CORS_ORIGINS contém domínios, não "localhost" ou "*"
#
# DEPOIS:
# ☐ pnpm build (com este .env.production loaded)
# ☐ npm run preview (simular produção localmente)
# ☐ fly deploy (deploy real)
#
