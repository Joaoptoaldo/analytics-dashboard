# .env.production — TEMPLATE

# ============================================================================
# FRONTEND (Vite Build)
# ============================================================================

VITE_API_BASE_URL=https://seu-dominio-producao.com/api

VITE_USE_EXTERNAL=false

# ============================================================================
# BACKEND (FastAPI)
# ============================================================================

# postgresql://user:senha@ep-xxx-pooler.region.aws.neon.tech/banco?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://usuario:senha@seu-host-banco.com/seu_banco?sslmode=require&channel_binding=require

# CORS whitelist - NUNCA use '*' em produção
CORS_ORIGINS=https://seu-dominio-producao.com,https://www.seu-dominio-producao.com

# Token para sincronização interna (>=32 chars) - DEVE SER SEGURO E ÚNICO
EXTERNAL_SYNC_TOKEN=seu-token-seguro-gerado-32-chars-minimo

# Intervalo mínimo entre sincronizações (em segundos)
EXTERNAL_SYNC_MIN_INTERVAL_SECONDS=60

# Modo de operação
ENV=production

# Permitir seed ao iniciar? CRÍTICO: false em produção
ALLOW_SEED=false
