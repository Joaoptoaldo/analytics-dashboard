# Production example .env (DO NOT COMMIT SECRETS)
ENV=production
ALLOW_SEED=false
# DATABASE_URL should be set as a secret in Render/host. Example format:
# postgresql://user:password@host:port/dbname?sslmode=require
# If using Neon, include sslmode=require. Avoid embedding channel_binding unless driver is verified.
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>/<DBNAME>?sslmode=require
# CORS whitelist (comma separated). Must not contain '*', localhost or 127.0.0.1
CORS_ORIGINS=https://dashboard.example.com
# Strong token for internal sync (>=32 chars)
EXTERNAL_SYNC_TOKEN=replace_with_strong_token_at_least_32_chars
# Frontend API base used when building frontend (must not point to localhost in production)
VITE_API_BASE_URL=https://api.yourdomain.com/api
